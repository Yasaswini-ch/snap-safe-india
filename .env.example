# The model that finds the clues in a photo. Any OpenAI-compatible endpoint with image input and tool calls works.
# Google AI Studio key: https://aistudio.google.com  (never commit this file once it holds a key)
OPEN_API_KEY=
# Or several keys from different Google projects, comma separated. Quota is counted per project and per model, so the keys add up:
# calls take turns across them, and a key that runs out of quota rests while the others carry on.
# OPEN_API_KEYS=key1,key2,key3
OPEN_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
# Main model: fast, and its boxes sit on the text. Free tier: 20 requests a day, 5 a minute (enable billing for more).
OPEN_MODEL=gemini-3-flash-preview
OPEN_LABEL="Gemini 3 Flash"
OPEN_HOST="Google AI Studio"
# Our own pacing, in requests per minute for that model; 0 = none. Use 4 on the free tier.
OPEN_RPM=4
# Fallback: when the main model's quota is used up on every key, this model answers instead (and the page says so). Gemma 4 has open
# weights and a much larger free quota, but it is slower and places its boxes less exactly. Leave empty for no fallback.
OPEN_FALLBACK_MODEL=gemma-4-26b-a4b-it
# A different model for the re-attacks (rounds 2 and later): its own quota, and a second opinion. Empty: same model.
# OPEN_RECHECK_MODEL=   (tried gemini-3.1-flash-lite: it boxes the whole card, so the agent pixelates the whole photo; do not use it)
# OPEN_RECHECK_RPM=4
# Telegram bot (python -m app.telegram_bot): the token from @BotFather, and photos allowed per chat per hour.
# TELEGRAM_BOT_TOKEN=
# BOT_RUNS_PER_HOUR=3
# Which country packs to load (app/regions): in, us, comma separated. "global" uses none.
# REGION=in
# With no key at all only the recorded samples play. MOCK=1 runs the whole loop offline instead, with a placeholder
# attacker and OpenCV inpainting.
# MOCK=1
# Off by default: live runs are open, limited only by the two limits below. Set a code to gate them (the samples never need one).
# LIVE_CODE=
# Optional WhatsApp bot, a webhook inside the web app (docs/whatsapp.md). All three of the first set switch it on; the secret is required too.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# Live run limits: per visitor per hour, and for the whole site per day.
# RUNS_PER_HOUR=4
# RUNS_PER_DAY=30
# Attacker reasoning effort for models that take one; "" uses the model default.
# ATTACK_EFFORT=low

# Optional, from the project this one grew out of: Meta's Model API (Muse Spark, SAM 3.1, Muse Image) gives a second
# "standard" mode with generative edits. Not needed for anything above.
# MODEL_API_KEY=
# MODEL_API_BASE=https://api.meta.ai/v1
# SPARK_MODEL=muse-spark-1.3
# IMAGE_MODEL=muse-image-1.0
